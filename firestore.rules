rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    // Staff Management screen: only an account with isAdmin == true
    // can promote/demote roles, grant admin, or deactivate other
    // staff accounts.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId);
      // A user can update their own doc, but never their own role or
      // admin flag (no self-promotion). An admin can update anyone's
      // doc, including role/isAdmin/isActive, for Staff Management.
      allow update: if (isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isAdmin == resource.data.isAdmin) ||
        isAdmin();
    }

    match /drugs/{drugId} {
  allow read: if isSignedIn();
  allow create, delete: if isStaff();
  allow update: if isStaff() ||
    (isSignedIn() &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity']) &&
     request.resource.data.stockQuantity <= resource.data.stockQuantity);

    }

    match /orders/{orderId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      // Staff can update anything. The order's own customer may only
      // update the payment-status fields (used by the in-app demo
      // payment simulation) — never quantities, status, or anything
      // else on someone else's order.
      allow update: if isStaff() ||
        (isSignedIn() &&
         resource.data.customerId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['paymentStatus', 'paymentMethod', 'paymentReference']));
      allow delete: if isStaff();
    }

    match /refill_requests/{requestId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.requesterId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isStaff();
    }

    match /prescriptions/{prescriptionId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.requesterId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isStaff();
    }

    match /medication_reminders/{reminderId} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /ai_chat_messages/{messageId} {
      // No staff side any more — the AI pharmacist chat is strictly
      // between a customer and the bot, so only the owner of the
      // thread can read or write it. The bot's own reply messages are
      // written by the customer's own client (senderId: 'ai-bot',
      // but threadId is still the signed-in customer's uid).
      allow read: if isSignedIn() && resource.data.threadId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.threadId == request.auth.uid;
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /promo_banners/{bannerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /stock_movements/{movementId} {
      // Append-only audit log — no update/delete rule means nobody
      // (staff included) can edit or remove an entry once written.
      // Staff can log any movement (restock, correction, damage,
      // expired write-off). A signed-in customer may only write the
      // automatic 'sale' entry attached to their own order, matching
      // the customer-side stockQuantity decrement already allowed on
      // /drugs — so a checkout keeps producing an audit trail even
      // though the customer isn't staff.
      allow read: if isStaff();
      allow create: if isStaff() ||
        (isSignedIn() &&
         request.resource.data.reason == 'sale' &&
         request.resource.data.staffId == request.auth.uid &&
         request.resource.data.delta < 0);
    }
  }
}